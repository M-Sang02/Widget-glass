<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="9dp" android:background="@drawable/bg_glass">
    <ImageView android:id="@+id/media_art" android:layout_width="42dp" android:layout_height="42dp" android:scaleType="centerCrop" android:clipToOutline="true" android:background="@drawable/bg_art_frame" android:src="@drawable/ic_album_placeholder" />
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="9dp">
        <TextView android:id="@+id/media_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chưa phát nhạc" android:textColor="#F5F6FF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/media_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mở ứng dụng nhạc" android:textColor="#C9D4EA" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
        <ProgressBar android:id="@+id/media_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="5dp" android:max="1000" android:progress="0" android:progressTint="#E8EEFF" android:progressBackgroundTint="#556F829E" />
        <TextView android:id="@+id/media_elapsed" android:layout_width="1dp" android:layout_height="1dp" android:text="00:00" android:visibility="gone" />
        <TextView android:id="@+id/media_duration" android:layout_width="1dp" android:layout_height="1dp" android:text="00:00" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/media_prev" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="6dp" android:background="@drawable/bg_control" android:gravity="center" android:text="◀" android:textColor="#F4F6FF" android:textSize="14sp" />
    <TextView android:id="@+id/media_play" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="5dp" android:background="@drawable/bg_control_active" android:gravity="center" android:text="▶" android:textColor="#F8FAFF" android:textSize="16sp" />
    <TextView android:id="@+id/media_next" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="5dp" android:background="@drawable/bg_control" android:gravity="center" android:text="▶" android:textColor="#F4F6FF" android:textSize="14sp" />
</LinearLayout>
